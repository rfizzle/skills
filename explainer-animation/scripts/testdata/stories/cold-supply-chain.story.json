   "color": "identity",
   "frame": "full",
   "callouts": [
    {
     "target": "signer",
     "text": "Signs the poisoned build"
    }
   ],
   "source": {
    "kind": "illustrative"
   }
  },
  {
   "id": "deploy",
   "phase": "run",
   "title": "The cluster accepts the image",
