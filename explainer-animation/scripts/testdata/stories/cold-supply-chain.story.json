  },
  {
   "id": "controls",
   "phase": "review",
   "title": "Where controls would have cut it",
   "body": "Each shield marks a link where a control breaks the chain. Pinned hashes stop it first; provenance and admission policy stop it before production.",
   "short": "Review",
   "touch": [],
