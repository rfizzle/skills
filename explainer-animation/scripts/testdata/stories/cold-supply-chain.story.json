 "steps": [
  {
   "id": "publish",
   "phase": "poison",
   "title": "Maintainer account is taken over",
   "body": "The attacker phishes a maintainer of a small utility library and publishes version 2.4.1. It carries a hidden install script that runs when the package is built.",
   "short": "Poisoned release",
   "touch": [
    "attacker",
    "registry"
   ],
   "uses": [
    [
     "attacker",
     "registry"
    ]
   ],
   "beats": [
    {
     "chain": [
      "attacker",
      "registry"
     ],
     "tag": "publish",
     "color": "danger",
     "says": "util-lib 2.4.1",
     "sayAt": "attacker"
    }
   ],
   "color": "danger",
   "frame": "full",
   "source": {
    "kind": "illustrative"
   }
  },
  {
   "id": "pull",
   "phase": "build",
   "title": "Build pulls the new version",
   "body": "The build asks for util-lib with a loose version range. The registry returns 2.4.1, and nothing compares it with a known hash.",
   "short": "Dependency pull",
   "touch": [
    "registry",
    "ci",
    "repo"
   ],
   "uses": [
    [
     "registry",
     "ci"
    ],
    [
     "repo",
     "ci"
    ]
   ],
   "beats": [
    {
     "chain": [
      "repo",
      "ci"
     ],
     "tag": "checkout",
     "color": "accent",
     "says": "package manifest",
     "sayAt": "repo"
    },
    {
     "exchange": [
      "ci",
      "registry"
     ],
     "tag": "resolve",
     "respTag": "package",
     "req": "util-lib ^2.4",
     "resp": "2.4.1 (new)",
     "mono": true,
     "color": "accent",
     "respColor": "danger"
    }
   ],
   "color": "accent",
   "frame": "full",
   "callouts": [
    {
     "target": "ci",
     "text": "Range, not pinned hash"
    }
   ],
   "source": {
    "kind": "illustrative"
   }
  },
  {
   "id": "build",
   "phase": "build",
   "title": "The hidden script runs in CI",
   "body": "The install script runs with the runner's permissions and rewrites a source file. Tests still pass, so the build looks healthy.",
   "short": "Script runs",
   "touch": [
    "ci"
   ],
   "uses": [],
   "beats": [
    {
     "card": "hook",
     "at": "ci",
     "title": "Install script",
     "rows": [
      "Runs at build time",
      "Patches a source file",
      "Tests still pass"
     ],
     "color": "danger",
     "then": "fold"
    },
    {
     "pulse": "ci",
     "color": "danger"
    }
   ],
   "color": "danger",
   "frame": {
    "hold": [
     "build"
    ]
   },
   "source": {
    "kind": "illustrative"
   }
  },
  {
   "id": "sign",
   "phase": "build",
   "title": "The image is built and signed",
   "body": "The CI signer signs the image, so it looks trusted. The signature proves who built it, not that its inputs were safe.",
   "short": "Signed anyway",
   "touch": [
    "ci",
    "signer",
    "artifacts"
   ],
   "uses": [
    [
     "ci",
     "signer"
    ],
    [
     "ci",
     "artifacts"
    ]
   ],
   "beats": [
