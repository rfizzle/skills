{
  "meta": {
    "id": "harvest-now-decrypt-later",
    "title": "Copied today, readable later",
    "kind": "plan",
    "audience": "executive",
    "redaction": "none",
    "scene": "exposure",
    "source": {
      "kind": "illustrative"
    },
    "_note": "Invented example for the custom scene seam (a deadline that has already started). Every number is illustrative and read from figures; exposure, deadlines and counts are computed by the scene. The threat is an estimated window, not a date."
  },
  "phases": [
    {
      "id": "taken",
      "title": "What is being taken",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "matters",
      "title": "When it matters",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "todo",
      "title": "What to do",
      "source": {
        "kind": "illustrative"
      }
    }
  ],
  "steps": [
    {
      "id": "today",
      "phase": "taken",
      "act": "today",
      "title": "Encrypted data is copied today",
      "body": "Attackers can copy encrypted traffic and files now and keep them. Nothing can be read yet, so nothing looks wrong. The copies simply wait.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "secret",
      "phase": "taken",
      "act": "secret",
      "title": "How long data must stay secret",
      "body": "Each kind of data has a period during which it must stay confidential. Card numbers lose value quickly. Health records and signing keys must stay secret far longer.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "arrives",
      "phase": "matters",
      "act": "arrives",
      "title": "When today's encryption could break",
      "body": "A capable quantum computer is expected inside a window, not on a date. Data that must stay secret past the early end of that window is exposed already.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "start",
      "phase": "matters",
      "act": "start",
      "title": "The last safe start is earlier",
      "body": "Moving to quantum-safe encryption takes years, and data stays exposed until it finishes. So the last safe start comes well before the machine arrives.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "plan",
      "phase": "todo",
      "act": "plan",
      "title": "The order of migration",
      "body": "Moving the longest-lived data first protects everything created from then on. It cannot protect what has already been copied. That stays exposed.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "ask",
      "phase": "todo",
      "act": "ask",
      "title": "Start with the longest-lived data",
      "body": "Begin migrating now, longest-lived data first, and keep the estimate under review. The argument holds whatever the exact date turns out to be.",
      "source": {
        "kind": "illustrative"
      }
    }
  ],
