  "steps": [
    {
      "id": "picture",
      "phase": "picture",
      "act": "picture",
      "title": "What could go wrong",
      "body": "Several routes lead to one event, and the event has costly consequences. Between them stand the controls we rely on.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "held",
      "phase": "today",
      "act": "held",
      "title": "A control that holds",
      "body": "A stolen staff sign-in is tried. Strong sign-in stops it at the first barrier, so the attack goes no further.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "through",
      "phase": "today",
      "act": "through",
      "title": "Thin layers let attacks through",
      "body": "A supplier's access is abused and a web page flaw is exploited. Weak limits and no least access let both reach the data.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "cost",
      "phase": "today",
      "act": "cost",
      "title": "What reaches the consequences",
      "body": "The leak is costly. Encryption, notification and backups soften regulatory and service impact, but weak detection leaves customer loss exposed.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "add",
      "phase": "plan",
      "act": "add",
      "title": "What the plan adds",
      "body": "Least access to data is added and detection and response is strengthened. The same supplier attack is now held.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "layers",
      "phase": "plan",
      "act": "layers",
      "title": "No single control is the defence",
      "body": "Each attack meets several layers, and one layer's gap is covered by the next. Keep every layer owned and tested.",
      "source": {
        "kind": "illustrative"
      }
    }
  ],
