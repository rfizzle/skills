{
  "meta": {
    "id": "shared-responsibility",
    "title": "Who owns what, and what nobody owns",
    "kind": "plan",
    "audience": "executive",
    "redaction": "none",
    "scene": "ownership",
    "source": {
      "kind": "illustrative"
    },
    "_note": "Invented example for the custom scene seam (ownership overlay). Every record is illustrative; counts and gaps are computed from cells and fixes by the scene."
  },
  "phases": [
    {
      "id": "who",
      "title": "Who owns what",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "falls",
      "title": "Where it falls through",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "closing",
      "title": "Closing the gaps",
      "source": {
        "kind": "illustrative"
      }
    }
  ],
  "steps": [
    {
      "id": "stack",
      "phase": "who",
      "act": "stack",
      "title": "What needs an owner",
      "body": "Every layer of the service, from hardware to data, has the same jobs to do. Each cell is a job that needs a name on it.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "provider",
      "phase": "who",
      "act": "provider",
      "title": "What the provider takes",
      "body": "The cloud provider owns the bottom of the stack outright: the buildings, the hardware and the network. Customers inherit that protection.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "ours",
      "phase": "who",
      "act": "ours",
      "title": "What our teams take",
      "body": "The platform team runs the middle layers and the product teams run the application. Most of the grid now has a name on it.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "gaps",
      "phase": "falls",
      "act": "gaps",
      "title": "Where it falls through",
      "body": "Some jobs belong to nobody. Others sit between teams, each assuming the other has it. These are where incidents hide.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "assign",
      "phase": "closing",
      "act": "assign",
      "title": "Each gap gets one owner",
      "body": "Every gap goes to a single team, with a plain statement of what that takes. The cell takes its new owner's colour.",
      "source": {
        "kind": "illustrative"
      }
    },
    {
      "id": "rule",
      "phase": "closing",
      "act": "rule",
      "title": "One name on every cell",
      "body": "Shared responsibility works only when each job has exactly one name on it. Review the grid whenever the stack changes.",
      "source": {
        "kind": "illustrative"
      }
    }
  ],
